{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error"
    },
    "plugins": ["unicorn", "typescript", "oxc", "react", "jsx-a11y"],
    "ignorePatterns": ["node_modules/**"],
    "options": {
        "reportUnusedDisableDirectives": "error"
    },
    "env": {
        "builtin": true,
        "browser": true
    },
    "globals": {
        "VERSION": "readonly",
        "VRCX_0_BUILD_LABEL": "readonly",
        "VRCX_0_BUILD_BADGE": "readonly"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-control-regex": "warn",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-has-content": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/heading-has-content": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/img-redundant-alt": "error",
        "jsx-a11y/no-access-key": "error",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/no-distracting-elements": "error",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/scope": "error",
        "jsx-a11y/tabindex-no-positive": "error"
    },
    "overrides": [
        {
            "files": ["**/*.{ts,tsx}"],
            "rules": {
                "typescript/no-explicit-any": "error"
            }
        },
        {
            "files": ["src/{domain,shared}/**/*.{ts,tsx}"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["@/features/**", "@/platform/**"],
                                "message": "Domain and shared modules must not depend on feature or platform adapters."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["src/{services,state}/**/*.{ts,tsx}"],
            "excludeFiles": ["src/services/preferencesService.test.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["@/features/**"],
                                "message": "Services and stores must not depend on feature modules."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["src/services/confusables.ts"],
            "rules": {
                "no-control-regex": "off",
                "no-irregular-whitespace": "off",
                "no-misleading-character-class": "off"
            }
        },
        {
            "files": ["src/ui/shadcn/label.tsx"],
            "rules": {
                "jsx-a11y/label-has-associated-control": "off"
            }
        },
        {
            "files": ["src/ui/shadcn/input-group.tsx"],
            "rules": {
                "jsx-a11y/click-events-have-key-events": "off",
                "jsx-a11y/no-noninteractive-element-interactions": "off"
            }
        },
        {
            "files": ["src/components/media/FullscreenImageViewer.tsx"],
            "rules": {
                "jsx-a11y/no-noninteractive-element-interactions": "off"
            }
        }
    ]
}
