export component AvatarPlaceholder inherits Rectangle {
    in property <length> diameter: 72px;

    width: root.diameter;
    height: root.diameter;
    border-radius: root.diameter / 2;
    background: #2a3441;
    clip: true;

    Rectangle {
        x: root.diameter * 0.355;
        y: root.diameter * 0.19;
        width: root.diameter * 0.29;
        height: root.diameter * 0.29;
        border-radius: self.width / 2;
        background: #6b7a8c;
    }

    Rectangle {
        x: root.diameter * 0.20;
        y: root.diameter * 0.54;
        width: root.diameter * 0.60;
        height: root.diameter * 0.50;
        border-radius: root.diameter * 0.18;
        background: #6b7a8c;
    }
}
