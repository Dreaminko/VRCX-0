export struct WristDeviceItem {
    label: string,
    percent: string,
    label-color: color,
    percent-color: color,
    battery-color: color,
    battery-fill: float,
    show-percent: bool,
    show-battery: bool,
}

export struct WristFeedItem {
    time: string,
    actor: string,
    detail: string,
    actor-color: color,
    detail-color: color,
    severity-color: color,
    has-actor: bool,
    show-severity: bool,
}

export component WristPanel inherits Window {
    width: 512px;
    height: 512px;
    background: transparent;

    in property <bool> dark-background: true;
    in property <color> accent-color: #5eead4;
    in property <[WristDeviceItem]> devices: [];
    in property <[WristFeedItem]> feed-lines: [];
    in property <string> footer-left;
    in property <string> footer-center;
    in property <string> footer-right;

    property <color> background-color: root.dark-background ? #101010eb : #10101096;
    property <color> panel-color: root.dark-background ? #161616cd : #16161678;
    property <color> divider-color: #78787855;
    property <color> row-divider-color: #7878782d;
    property <color> text-color: #eeeeee;
    property <color> muted-color: #a8a8a8;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: root.background-color;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 38px;
        background: root.panel-color;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 30px;
        width: parent.width;
        height: 30px;
        background: root.panel-color;
    }

    Rectangle {
        x: 0px;
        y: 38px;
        width: parent.width;
        height: 1px;
        background: root.divider-color;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 30px;
        width: parent.width;
        height: 1px;
        background: root.divider-color;
    }

    Rectangle {
        x: 18px;
        y: 8px;
        width: parent.width - 36px;
        height: 24px;
        clip: true;

        HorizontalLayout {
            x: 0px;
            y: 0px;
            height: 24px;
            spacing: 8px;
            alignment: start;

            for device in root.devices : HorizontalLayout {
                spacing: 5px;

                Text {
                    text: device.label;
                    font-size: 14px;
                    vertical-alignment: center;
                    color: device.label-color;
                }

                if device.show-percent: Text {
                    text: device.percent;
                    font-size: 13px;
                    vertical-alignment: center;
                    color: device.percent-color;
                }

                if device.show-battery: Rectangle {
                    width: 26px;

                    Rectangle {
                        x: 0px;
                        y: 6px;
                        width: 20px;
                        height: 12px;
                        border-color: device.battery-color;
                        border-width: 2px;
                        background: transparent;

                        Rectangle {
                            x: 4px;
                            y: 4px;
                            width: 12px * device.battery-fill;
                            height: 4px;
                            background: device.battery-color;
                        }
                    }

                    Rectangle {
                        x: 20px;
                        y: 10px;
                        width: 3px;
                        height: 4px;
                        background: device.battery-color;
                    }
                }
            }
        }
    }

    for line[index] in root.feed-lines : Rectangle {
        x: 18px;
        y: 44px + index * 34px;
        width: parent.width - 36px;
        height: 34px;
        visible: self.y + self.height < root.height - 30px;

        Rectangle {
            x: 0px;
            y: 4px;
            width: 3px;
            height: 23px;
            visible: line.show-severity;
            background: line.severity-color;
        }

        Text {
            x: 7px;
            y: 0px;
            width: 45px;
            height: 31px;
            text: line.time;
            font-size: 14px;
            vertical-alignment: center;
            color: root.muted-color;
        }

        HorizontalLayout {
            x: 58px;
            y: 0px;
            width: parent.width - 58px;
            height: 31px;
            spacing: 5px;

            if line.has-actor: Text {
                horizontal-stretch: 0;
                text: line.actor;
                font-size: 17px;
                vertical-alignment: center;
                color: line.actor-color;
            }

            Text {
                horizontal-stretch: 1;
                text: line.detail;
                font-size: 17px;
                vertical-alignment: center;
                overflow: elide;
                color: line.detail-color;
            }
        }

        Rectangle {
            x: 0px;
            y: 31px;
            width: parent.width;
            height: 1px;
            background: root.row-divider-color;
        }
    }

    Text {
        x: 18px;
        y: parent.height - 22px;
        width: 128px;
        height: 17px;
        text: root.footer-left;
        font-size: 13px;
        color: root.muted-color;
    }

    Text {
        x: parent.width / 2 - 90px;
        y: parent.height - 22px;
        width: 180px;
        height: 17px;
        text: root.footer-center;
        font-size: 13px;
        horizontal-alignment: center;
        color: root.muted-color;
    }

    Text {
        x: parent.width - 98px;
        y: parent.height - 22px;
        width: 80px;
        height: 17px;
        text: root.footer-right;
        font-size: 13px;
        horizontal-alignment: right;
        color: root.muted-color;
    }
}
